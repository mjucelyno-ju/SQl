
CREATE TABLE produtos (
    id_produto SERIAL PRIMARY KEY,

    nome VARCHAR(100) NOT NULL UNIQUE,

    descricao TEXT,

    preco DECIMAL(10,2) NOT NULL
        CHECK (preco > 0),

    categoria VARCHAR(30) NOT NULL
        CHECK (categoria IN (
            'Hambúrguer',
            'Bebida',
            'Acompanhamento',
            'Sobremesa'
        )),

    disponivel BOOLEAN NOT NULL DEFAULT TRUE
);
